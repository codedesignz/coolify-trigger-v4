# Variables usadas en worker/docker-compose.yml
# En Coolify, estas se definen como Environment Variables

# --- Conexión a la Webapp ---
TRIGGER_API_URL=https://trigger.example.com
OTEL_EXPORTER_OTLP_ENDPOINT=https://trigger.example.com/otel

# --- Autenticación del Worker ---
TRIGGER_WORKER_TOKEN=
MANAGED_WORKER_SECRET=

# --- Redes de los contenedores efimeros (mismo host Docker que Webapp) ---
# Variable oficial consumida por Trigger.dev Supervisor. Usa nombres fisicos
# de Docker separados por coma y sin espacios.
# No agregues el UUID del recurso Coolify: MinIO y S2 se alcanzan por IP privada.
DOCKER_RUNNER_NETWORKS=supervisor

# Red externa a la que se conecta el propio contenedor Supervisor.
# Debe coincidir con la entrada principal de DOCKER_RUNNER_NETWORKS.
TRIGGER_RUNNER_NETWORK=supervisor

# --- Registry (opcional) ---
DOCKER_REGISTRY_URL=
DOCKER_REGISTRY_USERNAME=
DOCKER_REGISTRY_PASSWORD=
