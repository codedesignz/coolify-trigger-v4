# Variables usadas en docker-compose.yml
# En Coolify, estas se definen como Magic Vars o Environment Variables

# --- Secrets (usar Magic Vars de Coolify) ---
SESSION_SECRET=
MAGIC_LINK_SECRET=
ENCRYPTION_KEY=
MANAGED_WORKER_SECRET=

# --- Postgres ---
POSTGRES_DB=trigger

# --- ClickHouse ---
# Default: start ClickHouse 26.2 with a new empty data volume while preserving
# any legacy Bitnami volume. Use migrate-bitnami only for an offline copy.
CLICKHOUSE_STORAGE_INIT_MODE=fresh
# CLICKHOUSE_MIGRATION_ACK=offline-copy-confirmed

# --- Realtime Streams v2 / s2-lite ---
REALTIME_STREAMS_DEFAULT_VERSION=v2
REALTIME_STREAMS_S2_BASIN=trigger-realtime
REALTIME_STREAMS_S2_ENDPOINT=http://s2/v1
REALTIME_STREAMS_S2_SKIP_ACCESS_TOKENS=true
REALTIME_STREAMS_S2_ACCESS_TOKEN=ignored
# Shared Docker network created by Webapp and used by Worker task containers.
TRIGGER_RUNNER_NETWORK=supervisor

# --- Registry externo (Tn-Registry) ---
DEPLOY_REGISTRY_HOST=
DEPLOY_REGISTRY_NAMESPACE=trigger
DEPLOY_REGISTRY_USERNAME=
DEPLOY_REGISTRY_PASSWORD=

# --- Otros opcionales ---
APP_LOG_LEVEL=info
TRIGGER_TELEMETRY_DISABLED=1

OPENAI_API_KEY=
