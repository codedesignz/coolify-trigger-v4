# Variables usadas en docker-compose.yml
# En Coolify, estas se definen como Magic Vars o Environment Variables

# --- Variables de Coolify ---
SERVICE_URL_WEBAPP=https://trigger.example.com
# Conserva los valores existentes. ENCRYPTION_KEY exige 32 bytes UTF-8.
SERVICE_PASSWORD_SESSION=
SERVICE_PASSWORD_MAGIC=
SERVICE_PASSWORD_ENCRYPTION=
SERVICE_PASSWORD_MANAGEDWORKER=
SERVICE_PASSWORD_POSTGRES=
SERVICE_PASSWORD_64_CLICKHOUSE=
SERVICE_PASSWORD_MINIO=
COOLIFY_APP_NAME=
COOLIFY_ENVIRONMENT_NAME=
COOLIFY_PROJECT_NAME=

# --- Postgres ---
POSTGRES_DB=trigger

# --- ClickHouse ---
# Default: start ClickHouse 26.2 with a new empty data volume while preserving
# any legacy Bitnami volume. Use migrate-bitnami only for an offline copy.
CLICKHOUSE_STORAGE_INIT_MODE=fresh
# CLICKHOUSE_MIGRATION_ACK=offline-copy-confirmed
# Mantiene la lectura de trazas antiguas en task_events_v1 durante la transición.
# Los runs nuevos siguen en clickhouse_v2. Revisa el plan antes de cambiar a 1.
EVENT_REPOSITORY_V1_REROUTE_ENABLED=0
# Proyecta eventos nuevos en Search v2 para la vista Logs de 4.8.3.
LOGS_SEARCH_DUAL_WRITE_ACTIVE=on

# --- Realtime Streams v2 / s2-lite ---
REALTIME_STREAMS_DEFAULT_VERSION=v2
REALTIME_STREAMS_S2_BASIN=trigger-realtime
REALTIME_STREAMS_S2_SKIP_ACCESS_TOKENS=true
REALTIME_STREAMS_S2_ACCESS_TOKEN=ignored
# Bind unauthenticated s2-lite only to this trusted private server address.
S2_PRIVATE_IP=10.21.30.15
S2_PRIVATE_API_PORT=4566
# docker-compose.yml derives REALTIME_STREAMS_S2_ENDPOINT from these values:
# http://10.21.30.15:4566/v1
# Nombre de la red local en cada host. Los runners usan la red del Worker.
TRIGGER_RUNNER_NETWORK=supervisor

# --- Object store / chat.agent snapshots ---
# Bind only the authenticated MinIO S3 API to this private server address.
# Port 9002 avoids MinIO's internal API port 9000, its console port 9001 and
# the S2 private binding on 4566. The console is not published.
MINIO_PRIVATE_IP=10.21.30.15
MINIO_PRIVATE_API_PORT=9002
# docker-compose.yml derives OBJECT_STORE_BASE_URL from these two values:
# http://10.21.30.15:9002
# Credentials continue to use the flat OBJECT_STORE_* variables configured
# inside docker-compose.yml.
# Do not set OBJECT_STORE_DEFAULT_PROTOCOL unless migrating to a named provider
# configured with the complete OBJECT_STORE_<PROTOCOL>_* variable set.

# --- Registry externo (Tn-Registry) ---
DEPLOY_REGISTRY_HOST=
DEPLOY_REGISTRY_NAMESPACE=trigger
DEPLOY_REGISTRY_USERNAME=
DEPLOY_REGISTRY_PASSWORD=

# --- Otros opcionales ---
OPENAI_API_KEY=
